{
  "name": "agenthub",
  "version": "1.0.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "Relay hub and command center for live Claude Code sessions — discover sessions, message them, group them into rooms across repos, and spawn new ones. Web dashboard + TUI.",
  "author": "Decky Fiyemonda (https://github.com/deckyfx)",
  "homepage": "https://github.com/deckyfx/agenthub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deckyfx/agenthub.git"
  },
  "keywords": ["claude", "claude-code", "agents", "multi-agent", "relay", "dashboard", "tui", "bun", "elysia"],
  "bin": {
    "agenthub": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch run src/index.ts server",
    "start": "bun run src/index.ts server",
    "tui": "bun run src/index.ts tui",
    "typecheck": "bun check",
    "test": "bun test",
    "build": "bun run typecheck && bun run src/build.ts",
    "build:local": "bun run typecheck && bun run src/build.ts --local",
    "db:generate": "drizzle-kit generate && bun run src/db/embed-migrations.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "ink": "^8.0.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
